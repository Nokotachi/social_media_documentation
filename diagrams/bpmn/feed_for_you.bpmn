    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_FeedForYou">
      <bpmndi:BPMNShape id="Participant_Client_di" bpmnElement="Participant_Client" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="500" height="260" />
